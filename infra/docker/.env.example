# Copy to infra/docker/.env (git-ignored). `docker compose` refuses to start while required values are empty.
# Generate values with:  openssl rand -base64 32

POSTGRES_PASSWORD=
JWT_SECRET=
GRAFANA_ADMIN_PASSWORD=
NPM_MYSQL_ROOT_PASSWORD=
NPM_MYSQL_PASSWORD=

# Browser origins allowed to call the API (web dev server and static build by default)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Optional seeded demo passwords (12+ chars); random ones are printed in `docker compose logs api` if unset
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_WORKER_PASSWORD=
