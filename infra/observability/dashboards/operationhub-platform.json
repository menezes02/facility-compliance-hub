{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "editorMode": "code", "expr": "up{job=\"operationhub-api\"}", "refId": "A" }],
      "title": "API Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "editorMode": "code", "expr": "pg_up", "refId": "A" }],
      "title": "Postgres Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "editorMode": "code", "expr": "time() - process_start_time_seconds{job=\"operationhub-api\"}", "refId": "A" }],
      "title": "API Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "editorMode": "code", "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" }],
      "title": "Host Memory Used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (route, status_code) (rate(operationhub_http_requests_total[5m]))", "legendFormat": "{{route}} / {{status_code}}", "range": true, "refId": "A" }],
      "title": "API Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (status_code) (increase(operationhub_http_requests_total[1h]))", "legendFormat": "{{status_code}}", "range": true, "refId": "A" }],
      "title": "HTTP Responses Last Hour",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "range": true, "refId": "A" }],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "range": true, "refId": "A" }],
      "title": "Container Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "Host CPU Used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}", "legendFormat": "used {{device}}", "range": true, "refId": "A" }],
      "title": "Root Disk Used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "pg_stat_database_numbackends{datname=\"operationhub\"}", "legendFormat": "connections", "range": true, "refId": "A" }],
      "title": "Postgres Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "operationhub-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "id": 12,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "editorMode": "code", "expr": "rate(pg_stat_database_xact_commit{datname=\"operationhub\"}[5m]) + rate(pg_stat_database_xact_rollback{datname=\"operationhub\"}[5m])", "legendFormat": "transactions", "range": true, "refId": "A" }],
      "title": "Postgres Transactions",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
