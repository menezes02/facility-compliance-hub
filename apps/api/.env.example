# Copy to apps/api/.env (git-ignored). The API refuses to start without DATABASE_URL and JWT_SECRET.

# Database (the local compose stack publishes Postgres on localhost:5432)
DATABASE_URL=postgres://operationhub:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/operationhub

# Token signing key: at least 32 random characters, never a placeholder.
#   openssl rand -base64 48
JWT_SECRET=

# Web app origin, and any extra browser origins allowed to call the API (comma separated).
APP_URL=http://localhost:5173
CORS_ORIGINS=

# Optional: choose the seeded demo account passwords (12+ chars). If unset, random
# ones are generated and printed once by the seed script.
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_WORKER_PASSWORD=
